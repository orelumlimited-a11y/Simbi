# Copy this file to .env (local dev) or set these in your host's dashboard
# (production) — never commit real values.

# Postgres connection string in production (e.g. from Neon or Supabase).
# Locally during development this can instead be a SQLite file, e.g.
# DATABASE_URL="file:./dev.db" — but prisma/schema.prisma's datasource
# provider must match (postgresql vs sqlite).
DATABASE_URL=""

# Random secret used to sign auth session tokens. Generate a fresh one per
# environment — never reuse the same value between dev and production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# The full public URL of this deployment (used to build tracking links and
# for auth callbacks). Locally: http://localhost:3000
NEXTAUTH_URL=""

# --- Notification providers ---
# Leave any of these blank to safely disable that channel — the app no-ops
# and records a "not configured" result instead of crashing.

# Email via Resend (https://resend.com) — get an API key after verifying a
# sending domain.
RESEND_API_KEY=""
EMAIL_FROM="notifications@example.com"

# SMS + WhatsApp via Twilio (https://twilio.com). SMS to US numbers also
# requires A2P 10DLC brand/campaign registration in the Twilio console
# before carriers will deliver it. WhatsApp requires a Meta Business
# verification and an approved message template for outbound notifications.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
